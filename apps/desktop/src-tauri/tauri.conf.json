{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ladX Studio",
  "version": "0.0.0",
  "identifier": "ai.ladx.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter=@ladx/desktop dev:next",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter=@ladx/desktop build:next",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "ladX Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
