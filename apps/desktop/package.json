{
  "name": "@ladx/desktop",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:next": "pnpm assets && next dev --turbopack -p 1420",
    "build": "pnpm assets && next build && node scripts/check-no-network.mjs",
    "build:next": "pnpm assets && next build && node scripts/check-no-network.mjs",
    "check:network": "node scripts/check-no-network.mjs",
    "panel:build": "node ../../packages/hmi/scripts/build-panel-runtime.mjs --out public",
    "assets": "node ../../packages/hmi/scripts/build-panel-runtime.mjs --out public && node ../../packages/ui/scripts/copy-brand.mjs --out public",
    "tauri": "tauri",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ladx/design-system": "workspace:*",
    "@ladx/hmi": "workspace:*",
    "@ladx/studio": "workspace:*",
    "@ladx/types": "workspace:*",
    "@ladx/ui": "workspace:*",
    "@tauri-apps/api": "^2.0.3",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "lucide-react": "^0.451.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
