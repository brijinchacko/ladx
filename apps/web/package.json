{
  "name": "@ladx/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm assets && next dev --turbopack -p 3000",
    "build": "pnpm assets && next build",
    "start": "next start -p 3000",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "admin:grant": "node scripts/grant-admin.mjs",
    "admin:list": "node scripts/grant-admin.mjs --list",
    "panel:build": "node ../../packages/hmi/scripts/build-panel-runtime.mjs --out public",
    "assets": "node ../../packages/hmi/scripts/build-panel-runtime.mjs --out public && node ../../packages/ui/scripts/copy-brand.mjs --out public"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/s3-request-presigner": "^3.665.0",
    "@ladx/cad": "workspace:*",
    "@ladx/design-system": "workspace:*",
    "@ladx/documents": "workspace:*",
    "@ladx/hmi": "workspace:*",
    "@ladx/studio": "workspace:*",
    "@ladx/types": "workspace:*",
    "@ladx/ui": "workspace:*",
    "bcryptjs": "^2.4.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.36.0",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.451.0",
    "next": "^15.5.0",
    "pdfjs-dist": "^4.9.155",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
