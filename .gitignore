# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
# Production builds go here so they cannot clobber the dev server's .next
.next-build/
.turbo/
*.tsbuildinfo

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Generated TS bindings — committed; CI verifies up-to-date.
# (Do NOT ignore packages/types/src/generated)

# Tauri
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target/

# Env / secrets
.env
.env.*.local
.env.local
*.pem
*.key

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Test artefacts
coverage/
playwright-report/
test-results/

# Husky output
.husky/_/

# Local storage backend (uploaded project files)
.ladx-storage/

# Local uploads written by the dev storage driver
apps/web/.ladx-storage/

# Generated by packages/hmi/scripts/build-panel-runtime.mjs on every build.
apps/web/public/panel/
apps/desktop/public/panel/

# Copied from packages/ui/assets/brand by copy-brand.mjs on every build.
apps/web/public/brand/
apps/desktop/public/brand/

# Built installers. Large binaries, uploaded to the server rather than committed.
apps/web/public/downloads/
