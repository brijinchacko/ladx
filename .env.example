# Copy to .env.local in each app that needs it. Phase 0 doesn't require any of these.

# ---- apps/web (Phase 1) ----
# Auth is native (email + bcrypt + Postgres-backed sessions). No third-party
# identity provider is required. OAuth providers can be layered on later.

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Postgres (Drizzle / pgvector)
DATABASE_URL=

# Inference — pick one. OpenRouter is the default for web (one key, multi-model).
# ANTHROPIC_API_KEY can be used directly later if cost/perf demands; the
# `ladx-inference` crate's trait abstraction makes it a one-file swap.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Cloudflare R2 for project file storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend
RESEND_API_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---- apps/desktop (Phase 2) ----
# Activation endpoint (only outbound network call the desktop is permitted to make)
LADX_ACTIVATION_URL=https://auth.ladx.ai/activate
